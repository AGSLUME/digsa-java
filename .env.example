# Copie este archivo a .env y diligéncielo. El .env no se versiona: en Azure las claves van en Key Vault.

# --- Base de datos ---
# Dueño de la base (corre las migraciones) y rol de la aplicación, con permisos mínimos (lo crea docker/postgres/01-rol-app.sh)
DIGSA_DB_DUENO=digsa_dueno
DIGSA_DB_DUENO_CLAVE=
DIGSA_DB_USUARIO=digsa_app
DIGSA_DB_CLAVE=

# --- Aplicación ---
# local | pruebas | produccion. Fuera de local se exige https, SMTP, remitente y dominios de los reportes.
# «local» muestra el código del segundo factor en pantalla y no pide captcha: solo para este equipo (el puerto queda en 127.0.0.1)
DIGSA_ENTORNO=local
DIGSA_URL=http://localhost:8080/
DIGSA_PUERTO=8080
DIGSA_SESION_MINUTOS=10

# --- Correo ---
# smtp | archivo (archivo solo se admite en local)
DIGSA_CORREO_MODO=archivo
DIGSA_CORREO_REMITENTE=
DIGSA_SMTP_HOST=
DIGSA_SMTP_PUERTO=587
DIGSA_SMTP_USUARIO=
DIGSA_SMTP_CLAVE=
# Con el perfil «pruebas» de docker compose: DIGSA_CORREO_MODO=smtp, DIGSA_SMTP_HOST=correo, DIGSA_SMTP_PUERTO=1025

# --- SMS de las alertas críticas (GMI P77 b) ---
# archivo (solo local: queda en el almacén, carpeta sms/) | ninguno (local y pruebas: la alerta va solo por correo) | el proveedor
# que se contrate. Con DIGSA_ENTORNO=produccion y sin proveedor la aplicación NO arranca.
DIGSA_SMS_MODO=archivo

# --- Reportes (dominios separados por coma, configurables: decisión D3) ---
DIGSA_DOMINIOS_REPORTES=
DIGSA_CORREO_REPORTES=

# --- Captcha (Cloudflare Turnstile). Sin clave secreta nadie ingresa, salvo en local ---
DIGSA_TURNSTILE_SITIO=
DIGSA_TURNSTILE_SECRETA=

# --- Analítica (rama analitica) ---
# Clave HMAC del seudónimo del paciente (Ley 1581): secreto de Key Vault, 32 caracteres o más. Con DIGSA_ENTORNO=produccion y sin
# ella la aplicación NO arranca. No se rota durante el contrato (cambiaría los seudónimos y rompería la continuidad de las cohortes).
DIGSA_ANALITICA_CLAVE_SEUDONIMO=
# Horas sin actividad tras las que un cargue en subida o mapeo vence y se descartan sus archivos.
DIGSA_ANALITICA_HORAS_ABANDONO=24
